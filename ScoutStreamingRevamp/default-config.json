{
  "$schema": "https://raw.githubusercontent.com/ow-mods/owml/master/schemas/config_schema.json",
  "enabled": true,
  "settings": {
    "ColoredCameras": {
      "type": "toggle",
      "value": false,
      "title": "Colored Cameras",
      "tooltip": "Whether to patch scout cameras to have color."
    },
    "FixHudTint": {
      "type": "selector",
      "value": "Automatic",
      "options": [
        "Never",
        "Always",
        "Automatic"
      ],
      "title": "Fix Hud Tint",
      "tooltip": "Whether to fix the green tint of the portable scout launcher."
    },
    "ScoutMode": {
      "type": "selector",
      "value": "Streaming",
      "options": [
        "Streaming",
        "Snapshot"
      ],
      "title": "Scout Mode"
    }
  }
}
